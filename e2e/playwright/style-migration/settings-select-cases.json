{
  "version": 1,
  "batch": "settings-select-surfaces",
  "cases": [
    {
      "id": "settings-select-light",
      "path": "/agents?settings=preference",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "settings-select-light-mobile",
      "path": "/agents?settings=preference",
      "theme": "light",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    },
    {
      "id": "settings-select-dark",
      "path": "/agents?settings=preference",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "settings-select-dark-mobile",
      "path": "/agents?settings=preference",
      "theme": "dark",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    }
  ]
}
