{
  "version": 1,
  "batch": "agent-tone-choices",
  "cases": [
    {
      "id": "tone-light",
      "path": "/agents/:agentId?tab=profile",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "tone-dark",
      "path": "/agents/:agentId?tab=profile",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "tone-mobile",
      "path": "/agents/:agentId?tab=profile",
      "theme": "light",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    }
  ]
}
