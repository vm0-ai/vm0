# This is a config for E2B sandbox template.
# You can use template ID to create a sandbox:

# Python SDK
# from e2b import Sandbox, AsyncSandbox
# sandbox = Sandbox("template_id") # Sync sandbox
# sandbox = await AsyncSandbox.create("template_id") # Async sandbox

# JS SDK
# import { Sandbox } from 'e2b'
# const sandbox = await Sandbox.create('template_id')

dockerfile = "e2b.Dockerfile"
template_id = "vm0-claude-code"

# Environment variables for container runtime
# These will be set dynamically when creating sandbox
[env]
# Runtime ID for this execution
VM0_RUNTIME_ID = "${VM0_RUNTIME_ID}"

# Webhook URL and token for sending events
VM0_WEBHOOK_URL = "${VM0_WEBHOOK_URL}"
VM0_WEBHOOK_TOKEN = "${VM0_WEBHOOK_TOKEN}"

# Anthropic API configuration (for Claude Code)
ANTHROPIC_BASE_URL = "${ANTHROPIC_BASE_URL}"
ANTHROPIC_AUTH_TOKEN = "${ANTHROPIC_AUTH_TOKEN}"
