# Disable auto-install of peer dependencies to avoid installing
# unnecessary optional peers from @clerk/clerk-js (react-native, @solana, viem, etc.)
auto-install-peers=false
resolve-peers-from-workspace-root=true

# Defend against npm supply-chain attacks: require packages to be at least
# 7 days old before installing. npm uses days while pnpm uses minutes.
# Internal @okouai packages are excluded so our own releases install
# immediately. For emergency upgrades, override pnpm per-command with
# `pnpm install --config.minimumReleaseAge=0`.
min-release-age=7
min-release-age-exclude[]=@okouai/*
minimumReleaseAge=10080
minimumReleaseAgeExclude=@okouai/*
