#!/sbin/openrc-run
# VM0 Vsock Agent - OpenRC service script
# Manages the vsock-agent for host-guest communication

name="vsock-agent"
description="VM0 Vsock Agent for host-guest communication"

command="/usr/bin/python3"
command_args="/usr/local/bin/vm0-agent/vsock-agent.py"
command_background="yes"
pidfile="/run/vsock-agent.pid"

# Let start-stop-daemon create the pidfile since Python doesn't create one
start_stop_daemon_args="--make-pidfile"

# Log output for debugging
output_log="/var/log/vsock-agent.log"
error_log="/var/log/vsock-agent.log"

depend() {
    # Start after local filesystems are mounted
    after localmount
}

start_pre() {
    # Ensure /run directory exists
    checkpath --directory --mode 0755 /run
    # Ensure log directory exists
    checkpath --directory --mode 0755 /var/log
}
