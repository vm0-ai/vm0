    "happy-dom": "^20.11.1",
    "i18next-cli": "^1.67.7",
    "msw": "^2.13.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unicode-emoji-json": "^0.9.0",
    "typescript-eslint": "^8.67.0",
