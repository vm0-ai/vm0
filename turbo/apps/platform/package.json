    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci --quiet && i18next-cli status",
    "lint:build-config": "node --test scripts/check-production-minification.node.mjs && tsx --test scripts/check-stable-chunks.node.ts",
