    "@tiptap/pm": "3.21.0",
    "@tiptap/react": "3.21.0",
    "ably": "^2.21.0",
    "ccstate": "^5.5.0",
    "ccstate-react": "^5.5.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.3.6",
    "idb": "~8.0.3",
    "lucide-react": "1.30.0",
    "marked": "17.0.5",
    "micromark-util-sanitize-uri": "^2.0.1",
    "path-to-regexp": "^8.4.0",
    "posthog-js": "^1.414.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.11",
    "react-zoom-pan-pinch": "4.0.3",
