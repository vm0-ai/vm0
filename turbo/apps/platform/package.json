  "devDependencies": {
    "@okouai/eslint-config": "workspace:*",
    "@okouai/eslint-rules": "workspace:*",
    "@sentry/cli": "^2.58.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.8",
