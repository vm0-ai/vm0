{
  "name": "@okouai/design-system",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node scripts/extract-tokens.mjs && node scripts/extract-components.mjs",
    "lint:generated": "node scripts/extract-tokens.mjs --check && node scripts/extract-components.mjs --check",
    "dev": "pnpm generate && vite --port 3007",
    "build": "pnpm generate && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "pnpm lint:generated && oxlint --deny-warnings && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@okouai/ui": "workspace:*",
    "lucide-react": "1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@okouai/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.34.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.6",
    "oxlint": "^1.75.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
