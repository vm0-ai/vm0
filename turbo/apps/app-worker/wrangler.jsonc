{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "okou-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./shell",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  // Phase-one previews read hashed app assets through the existing public
  // static.okou.io R2 origin. The Worker source also supports a native
  // STATIC_ASSETS_BUCKET binding once a dedicated deploy token is provisioned.
  "env": {
    "preview": {
      "name": "okou-app-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "PUBLIC_BRAND": "okou",
      },
    },
    "production": {
      "name": "okou-app-production",
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
