{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vm0-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "placement": { "mode": "smart" },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": false },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "env": {
    "preview": {
      "name": "vm0-api-preview",
      "workers_dev": false,
      "preview_urls": true,
      "placement": { "mode": "smart" },
      "limits": { "cpu_ms": 300000 },
      "observability": { "enabled": false },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "secrets": {
        "required": [
          "VM0_WORKER_ENV_01",
          "VM0_WORKER_ENV_02",
          "VM0_WORKER_ENV_03",
          "VM0_WORKER_ENV_04",
          "VM0_WORKER_ENV_05",
          "VM0_WORKER_ENV_06",
          "VM0_WORKER_ENV_07",
          "VM0_WORKER_ENV_08",
          "VM0_WORKER_ENV_09",
          "VM0_WORKER_ENV_10",
          "VM0_WORKER_ENV_11",
          "VM0_WORKER_ENV_12",
          "VM0_WORKER_ENV_13",
          "VM0_WORKER_ENV_14",
          "VM0_WORKER_ENV_15",
          "VM0_WORKER_ENV_16",
          "VM0_WORKER_ENV_17",
          "VM0_WORKER_ENV_18",
          "VM0_WORKER_ENV_19",
          "VM0_WORKER_ENV_20",
          "VM0_WORKER_ENV_21",
          "VM0_WORKER_ENV_22",
          "VM0_WORKER_ENV_23",
          "VM0_WORKER_ENV_24",
          "VM0_WORKER_ENV_25",
          "VM0_WORKER_ENV_26",
          "VM0_WORKER_ENV_27",
          "VM0_WORKER_ENV_28",
          "VM0_WORKER_ENV_29",
          "VM0_WORKER_ENV_30",
          "VM0_WORKER_ENV_31",
          "VM0_WORKER_ENV_32",
        ],
      },
    },
    "production": {
      "name": "vm0-api-production",
      "workers_dev": false,
      "preview_urls": false,
      "placement": { "mode": "smart" },
      "observability": { "enabled": false },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
    },
  },
}
