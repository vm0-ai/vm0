{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": [
        "app/**/page.{ts,tsx}",
        "app/**/layout.{ts,tsx}",
        "app/api/**/route.{ts,tsx}",
        "app/v1/**/route.{ts,tsx}",
        "middleware.{ts,tsx}",
        "middleware.cors.ts",
        "i18n.ts",
        "navigation.ts",
        "scripts/*.ts",
        "**/__tests__/**/*.{test,spec}.{ts,tsx}",
        "**/*.{test,spec}.{ts,tsx}",
        "src/lib/connector/platform/**/*.ts"
      ],
      "project": ["**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignoreDependencies": [
        "e2b",
        "@testing-library/react",
        "@types/tar",
        "import-in-the-middle",
        "require-in-the-middle",
        "cpu-features",
        "oxlint",
        "react-dom",
        "@types/react-dom"
      ],
      "ignoreBinaries": ["oxlint", "next", "drizzle-kit"],
      "next": {
        "entry": ["next.config.{js,ts,mjs}"]
      },
      "drizzle": {
        "config": []
      }
    },
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/instrument.ts",
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@types/tar", "tsup"],
      "ignoreBinaries": ["tsup"]
    },
    "apps/docs": {
      "entry": ["source.config.ts", "eslint.config.js"],
      "project": ["**/*.{ts,tsx,mdx,js,mjs}"],
      "ignoreDependencies": [
        "@vm0/typescript-config",
        "react-dom",
        "@types/react-dom",
        "tailwindcss"
      ],
      "ignoreBinaries": ["next", "fumadocs-mdx"]
    },
    "apps/platform": {
      "entry": ["src/main.ts", "**/*.{test,spec}.ts?(x)"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["custom-eslint/**", "vite.config.ts", "vitest.config.ts"],
      "ignoreDependencies": [
        "tailwindcss",
        "typescript-eslint",
        "@sentry/vite-plugin",
        "@tailwindcss/vite",
        "@clerk/clerk-react",
        "@vitejs/plugin-react",
        "eslint-plugin-turbo",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "eslint-plugin-react",
        "@testing-library/jest-dom"
      ],
      "ignoreBinaries": ["vite"],
      "vite": {
        "config": []
      },
      "eslint": {
        "config": []
      },
      "vitest": {
        "config": []
      }
    },
    "apps/runner": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsup"],
      "ignoreBinaries": ["tsup"]
    },
    "packages/core": {
      "entry": [
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/sandbox-scripts": {
      "entry": [
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["src/scripts/**"]
    },
    "packages/ui": {
      "entry": [
        "src/test/setup.ts",
        "src/**/__tests__/**/*.{test,spec}.{ts,tsx}",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "autoprefixer",
        "@vitejs/plugin-react",
        "@testing-library/jest-dom"
      ],
      "vitest": {
        "config": []
      }
    },
    "packages/eslint-config": {
      "entry": [],
      "project": ["**/*.js"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": ["*.json"],
      "ignoreUnresolved": ["next"]
    },
    "packages/proxy": {
      "entry": [],
      "project": ["**/*.{js,json}"]
    }
  },
  "ignore": [
    "**/*.d.ts",
    ".next/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "**/drizzle.config.ts",
    "**/custom-eslint/**",
    "apps/platform/src/mocks/browser.ts",
    "apps/platform/src/mocks/mock-log-detail-data.ts",
    "apps/platform/src/signals/test-utils.ts",
    "apps/platform/src/signals/__tests__/test-helpers.ts",
    "apps/platform/src/signals/location.ts",
    "apps/platform/src/signals/log.ts",
    "apps/platform/src/signals/page-signal.ts",
    "apps/platform/src/signals/utils.ts",
    "apps/platform/src/signals/scope.ts",
    "apps/platform/src/views/router/link.tsx",
    "apps/platform/src/test/mocks/clerk-react.ts",
    "apps/platform/src/test/mocks/clerk-react-experimental.ts",
    "apps/platform/src/test/setup.ts",
    "apps/runner/src/lib/firecracker/index.ts",
    "apps/runner/src/lib/firecracker/guest.ts",
    "apps/runner/src/lib/firecracker/network.ts",
    "apps/runner/src/lib/firecracker/netns-pool.ts",
    "apps/runner/src/lib/firecracker/client.ts",
    "apps/runner/src/lib/firecracker/vm.ts",
    "apps/web/src/test/setup.ts",
    "apps/web/src/lib/schedule/schedule-service.ts",
    "apps/web/src/lib/model-provider/model-provider-service.ts",
    "apps/cli/src/lib/api/api-client.ts",
    "apps/cli/src/lib/utils/paginate.ts",
    "apps/cli/src/commands/cook/cook.ts",
    "packages/core/src/contracts/public/agents.ts",
    "apps/web/src/lib/slack/**",
    "apps/web/src/lib/auth/sandbox-token.ts",
    "scripts/rebuild-snapshots.ts",
    "scripts/rebuild-snapshots-from-db.ts"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@vm0/eslint-config",
    "oxlint",
    "eslint",
    "eslint-plugin-turbo",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "typescript-eslint"
  ],
  "ignoreBinaries": ["oxlint", "eslint"],
  "ignoreExportsUsedInFile": true,
  "ignoreWorkspaces": [],
  "ignoreUnresolved": [],
  "eslint": {
    "config": []
  },
  "tsup": {
    "config": []
  }
}
