{
  "name": "@okouai/api-contracts",
  "version": "1.376.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/contracts/index.ts",
      "types": "./src/contracts/index.ts"
    },
    "./contracts": {
      "import": "./src/contracts/index.ts",
      "types": "./src/contracts/index.ts"
    },
    "./contracts/*": {
      "import": "./src/contracts/*.ts",
      "types": "./src/contracts/*.ts"
    }
  },
  "scripts": {
    "build:runtime-api-schema": "tsx src/runtime-api-schema/cli.ts build",
    "generate:python": "tsx src/python-bindings/generate.ts",
    "generate:rust": "tsx src/rust-bindings/generate.ts",
    "lint-runtime-api-compat": "tsx src/runtime-api-schema/cli.ts lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.contracts.json --noEmit && tsc -p tsconfig.python-bindings.json --noEmit && tsc -p tsconfig.rust-bindings.json --noEmit && tsc -p tsconfig.runtime-api-schema.json --noEmit"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "@okouai/connectors": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "eslint": "^9.34.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
