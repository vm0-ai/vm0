{
  http_port 8080
  https_port 8443
  storage file_system {
    root /home/vscode/.local/certs/caddy
  }
}

# Main domain redirect to www
vm7.ai:8443 {
  tls {
    dns cloudflare {env.CF_DNS_API_TOKEN}
  }
  redir https://www.vm7.ai:8443{uri} permanent
}

# Web application
www.vm7.ai:8443 {
  tls {
    dns cloudflare {env.CF_DNS_API_TOKEN}
  }

  @cors_preflight {
    method OPTIONS
    header Origin https://app.vm7.ai:8443
  }
  route @cors_preflight {
    header Access-Control-Allow-Origin "https://app.vm7.ai:8443"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    header Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With, Accept"
    header Access-Control-Allow-Credentials "true"
    header Access-Control-Max-Age "86400"
    respond 204
  }

  reverse_proxy localhost:3000
}

# Docs application
docs.vm7.ai:8443 {
  tls {
    dns cloudflare {env.CF_DNS_API_TOKEN}
  }
  reverse_proxy localhost:3001
}

# App application
app.vm7.ai:8443 {
  tls {
    dns cloudflare {env.CF_DNS_API_TOKEN}
  }
  reverse_proxy localhost:3002
}

# HTTP redirects to HTTPS
http://vm7.ai:8080 {
  redir https://www.vm7.ai:8443{uri} permanent
}

http://www.vm7.ai:8080 {
  redir https://www.vm7.ai:8443{uri} permanent
}

http://docs.vm7.ai:8080 {
  redir https://docs.vm7.ai:8443{uri} permanent
}

http://app.vm7.ai:8080 {
  redir https://app.vm7.ai:8443{uri} permanent
}
