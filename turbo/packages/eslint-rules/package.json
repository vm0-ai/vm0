{
  "name": "@vm0/eslint-rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./api": {
      "import": "./src/api/index.ts",
      "types": "./src/api/index.ts"
    },
    "./ccstate": {
      "import": "./src/ccstate/index.ts",
      "types": "./src/ccstate/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.61.1"
  },
  "devDependencies": {
    "@typescript-eslint/rule-tester": "^8.61.1",
    "@types/node": "^24.3.0",
    "@vm0/eslint-config": "workspace:*",
    "@vm0/typescript-config": "workspace:*",
    "eslint": "^9.34.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
