{
  "name": "@okouai/db",
  "version": "1.243.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./schema/*": {
      "import": "./src/schema/*.ts",
      "types": "./src/schema/*.ts"
    },
    "./jsonb-contracts/*": {
      "import": "./src/jsonb-contracts/*.ts",
      "types": "./src/jsonb-contracts/*.ts"
    },
    "./operations/model-provider-built-in-identity": {
      "import": "./src/operations/model-provider-built-in-identity.ts",
      "types": "./src/operations/model-provider-built-in-identity.ts"
    },
    "./operations/org-metadata-canonical-write": {
      "import": "./src/operations/org-metadata-canonical-write.ts",
      "types": "./src/operations/org-metadata-canonical-write.ts"
    },
    "./operations/org-plan-entitlement-canonical-write": {
      "import": "./src/operations/org-plan-entitlement-canonical-write.ts",
      "types": "./src/operations/org-plan-entitlement-canonical-write.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm lint:jsonb-contracts && oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "test:migration-consistency": "pnpm test:migration-runner && pnpm test:pi-memory-checkpoint-settlement && pnpm test:pi-memory-citations && tsx scripts/test-migration-consistency-schema.ts",
    "test:migration-runner": "tsx scripts/test-migration-runner-timeouts.ts",
    "lint:jsonb-contracts": "tsx scripts/check-jsonb-contracts.ts",
    "test:pi-memory-checkpoint-settlement": "tsx scripts/test-pi-memory-checkpoint-settlement.ts",
    "test:pi-memory-citations": "tsx scripts/test-pi-memory-citation-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@clerk/backend": "^3.13.1",
    "@okouai/api-contracts": "workspace:*",
    "@okouai/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.34.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "^8.23.0",
    "tsx": "^4.21.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  }
}
