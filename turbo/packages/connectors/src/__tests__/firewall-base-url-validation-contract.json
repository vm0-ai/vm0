      "expectedValid": false
    },
    {
      "category": "path-safety",
      "name": "encoded backslash path is invalid",
      "base": "https://api.example.com/%5cadmin",
      "expectedValid": false
    },
    {
      "category": "path-safety",
      "name": "repeatedly encoded backslash path is invalid",
