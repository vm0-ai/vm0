      "expectedValid": false
    },
    {
      "category": "path-safety",
      "name": "encoded parent path segment is invalid",
      "base": "https://api.example.com/%2e%2e/admin",
      "expectedValid": false
    },
    {
      "category": "path-safety",
      "name": "repeatedly encoded parent path segment is invalid",
