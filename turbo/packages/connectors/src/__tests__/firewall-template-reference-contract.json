{
  "simpleReferenceCases": [
    {
      "name": "secret without whitespace",
      "template": "${{secrets.TOKEN}}",
      "expectedReferences": [{ "namespace": "secrets", "name": "TOKEN" }]
    },
    {
      "name": "variable without whitespace",
      "template": "${{vars._TOKEN9}}",
      "expectedReferences": [{ "namespace": "vars", "name": "_TOKEN9" }]
    },
    {
      "name": "horizontal tab whitespace",
      "template": "${{\u0009vars.VALUE\u0009}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "line feed whitespace",
      "template": "${{\u000avars.VALUE\u000a}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "vertical tab whitespace",
      "template": "${{\u000bvars.VALUE\u000b}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "form feed whitespace",
      "template": "${{\u000cvars.VALUE\u000c}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "carriage return whitespace",
      "template": "${{\u000dvars.VALUE\u000d}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "space whitespace",
      "template": "${{ vars.VALUE }}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "no-break space whitespace",
      "template": "${{\u00a0vars.VALUE\u00a0}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "ogham space mark whitespace",
      "template": "${{\u1680vars.VALUE\u1680}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "en quad whitespace",
      "template": "${{\u2000vars.VALUE\u2000}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "em quad whitespace",
      "template": "${{\u2001vars.VALUE\u2001}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "en space whitespace",
      "template": "${{\u2002vars.VALUE\u2002}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "em space whitespace",
      "template": "${{\u2003vars.VALUE\u2003}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "three-per-em space whitespace",
      "template": "${{\u2004vars.VALUE\u2004}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "four-per-em space whitespace",
      "template": "${{\u2005vars.VALUE\u2005}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "six-per-em space whitespace",
      "template": "${{\u2006vars.VALUE\u2006}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "figure space whitespace",
      "template": "${{\u2007vars.VALUE\u2007}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "punctuation space whitespace",
      "template": "${{\u2008vars.VALUE\u2008}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "thin space whitespace",
      "template": "${{\u2009vars.VALUE\u2009}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "hair space whitespace",
      "template": "${{\u200avars.VALUE\u200a}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "line separator whitespace",
      "template": "${{\u2028vars.VALUE\u2028}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "paragraph separator whitespace",
      "template": "${{\u2029vars.VALUE\u2029}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "narrow no-break space whitespace",
      "template": "${{\u202fvars.VALUE\u202f}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "medium mathematical space whitespace",
      "template": "${{\u205fvars.VALUE\u205f}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "ideographic space whitespace",
      "template": "${{\u3000vars.VALUE\u3000}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "byte order mark whitespace",
      "template": "${{\ufeffvars.VALUE\ufeff}}",
      "expectedReferences": [{ "namespace": "vars", "name": "VALUE" }]
    },
    {
      "name": "python file separator whitespace is rejected",
      "template": "${{\u001cvars.VALUE\u001c}}",
      "expectedReferences": []
    },
    {
      "name": "python group separator whitespace is rejected",
      "template": "${{\u001dvars.VALUE\u001d}}",
      "expectedReferences": []
    },
    {
      "name": "python record separator whitespace is rejected",
      "template": "${{\u001evars.VALUE\u001e}}",
      "expectedReferences": []
    },
    {
      "name": "python unit separator whitespace is rejected",
      "template": "${{\u001fvars.VALUE\u001f}}",
      "expectedReferences": []
    },
    {
      "name": "python next line whitespace is rejected",
      "template": "${{\u0085vars.VALUE\u0085}}",
      "expectedReferences": []
    },
    {
      "name": "unsupported namespace",
      "template": "${{ env.VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "case-mismatched namespace",
      "template": "${{ Secrets.VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "identifier cannot start with digit",
      "template": "${{ vars.9VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "identifier cannot contain hyphen",
      "template": "${{ vars.BAD-VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "identifier must be ascii",
      "template": "${{ vars.é }}",
      "expectedReferences": []
    },
    {
      "name": "whitespace before dot is rejected",
      "template": "${{ vars .VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "whitespace after dot is rejected",
      "template": "${{ vars. VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "missing opening dollar",
      "template": "{{ vars.VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "missing closing brace",
      "template": "${{ vars.VALUE }",
      "expectedReferences": []
    },
    {
      "name": "split opening delimiter",
      "template": "$ {{ vars.VALUE }}",
      "expectedReferences": []
    },
    {
      "name": "reference surrounded by literal text",
      "template": "Bearer ${{ secrets.TOKEN }} suffix",
      "expectedReferences": [{ "namespace": "secrets", "name": "TOKEN" }]
    },
    {
      "name": "multiple references preserve source order",
      "template": "${{ vars.USER }}:${{ secrets.PASS }}:${{ vars.USER }}",
      "expectedReferences": [
        { "namespace": "vars", "name": "USER" },
        { "namespace": "secrets", "name": "PASS" },
        { "namespace": "vars", "name": "USER" }
      ]
    },
    {
      "name": "later valid reference follows malformed input",
      "template": "${{ env.BAD }} ${{ secrets.GOOD }}",
      "expectedReferences": [{ "namespace": "secrets", "name": "GOOD" }]
    }
  ],
  "basicTemplateCases": [
    {
      "name": "basic secret and variable references",
      "template": "${{ basic(secrets.USER, vars.PASS) }}",
      "expectedTemplateReferences": {
        "secrets": ["USER"],
        "vars": ["PASS"]
      },
      "expectedDiagnosticNames": ["USER", "PASS"]
    },
    {
      "name": "basic ascii whitespace",
      "template": "${{\u0009\u000abasic(\u000bsecrets.USER\u000c,\u000dvars.PASS )\u0009}}",
      "expectedTemplateReferences": {
        "secrets": ["USER"],
        "vars": ["PASS"]
      },
      "expectedDiagnosticNames": ["USER", "PASS"]
    },
    {
      "name": "basic literal arguments",
      "template": "${{ basic(\"secrets.FAKE\", \"vars.FAKE\") }}",
      "expectedTemplateReferences": { "secrets": [], "vars": [] },
      "expectedDiagnosticNames": []
    },
    {
      "name": "basic empty first argument",
      "template": "${{ basic(, vars.USER) }}",
      "expectedTemplateReferences": { "secrets": [], "vars": ["USER"] },
      "expectedDiagnosticNames": ["USER"]
    },
    {
      "name": "basic literal shields nested simple reference",
      "template": "${{ basic(\"${{ secrets.FAKE }}\", secrets.REAL) }}",
      "expectedTemplateReferences": { "secrets": ["REAL"], "vars": [] },
      "expectedDiagnosticNames": ["REAL"]
    },
    {
      "name": "basic byte order mark whitespace is rejected",
      "template": "${{\ufeffbasic(secrets.USER, secrets.PASS)\ufeff}}",
      "expectedTemplateReferences": { "secrets": [], "vars": [] },
      "expectedDiagnosticNames": []
    },
    {
      "name": "basic python next line whitespace is rejected",
      "template": "${{\u0085basic(secrets.USER, secrets.PASS)\u0085}}",
      "expectedTemplateReferences": { "secrets": [], "vars": [] },
      "expectedDiagnosticNames": []
    },
    {
      "name": "malformed basic keeps later valid template visible",
      "template": "prefix ${{ basic(\"unterminated ${{ basic(secrets.USER, secrets.PASS) }}",
      "expectedTemplateReferences": {
        "secrets": ["USER", "PASS"],
        "vars": []
      },
      "expectedDiagnosticNames": ["USER", "PASS"]
    },
    {
      "name": "simple and basic references preserve diagnostic order",
      "template": "${{ vars.FIRST }} ${{ basic(secrets.USER, vars.PASS) }} ${{ secrets.LAST }}",
      "expectedTemplateReferences": {
        "secrets": ["LAST", "USER"],
        "vars": ["FIRST", "PASS"]
      },
      "expectedDiagnosticNames": ["FIRST", "USER", "PASS", "LAST"]
    },
    {
      "name": "unsupported basic namespace is rejected",
      "template": "${{ basic(env.USER, secrets.PASS) }}",
      "expectedTemplateReferences": { "secrets": [], "vars": [] },
      "expectedDiagnosticNames": []
    }
  ]
}
