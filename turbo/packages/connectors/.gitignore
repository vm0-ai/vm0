src/firewalls/*

# Firewall metadata produced by @vm0/firewalls-generator at install time.
src/firewall-metadata/*.generated.ts
src/firewall-metadata/.metadata-*
src/firewall-metadata/.*.previous-*
src/firewall-metadata/details/*

# Firewall routing metadata produced by @vm0/firewalls-generator at install time.
src/firewall-routing-metadata/*.generated.ts
src/firewall-routing-metadata/.routing-metadata-*
src/firewall-routing-metadata/.*.previous-*
src/firewall-routing-metadata/details/*
