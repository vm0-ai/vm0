# Firewall configs produced by @vm0/firewalls-generator at install time.
src/firewalls/*
!src/firewalls/index.ts

# Firewall metadata produced by @vm0/firewalls-generator at install time.
src/firewall-metadata/*.generated.ts
src/firewall-metadata/.metadata-*
src/firewall-metadata/.*.previous-*
src/firewall-metadata/details/*

# Stale firewall execution metadata generated by older branches.
src/firewall-execution-metadata/*.generated.ts
src/firewall-execution-metadata/.metadata-*
src/firewall-execution-metadata/.*.previous-*
src/firewall-execution-metadata/details/*
