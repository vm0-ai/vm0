{
  "name": "@okouai/connector-catalog-validation",
  "version": "2.0.11",
  "private": true,
  "type": "module",
  "exports": {
    "./artifacts/*": {
      "import": "./src/artifacts/*.ts",
      "types": "./src/artifacts/*.ts"
    },
    "./authority": {
      "import": "./src/authority.ts",
      "types": "./src/authority.ts"
    },
    "./compatibility": {
      "import": "./src/compatibility.ts",
      "types": "./src/compatibility.ts"
    },
    "./runtime-projection": {
      "import": "./src/runtime-projection.ts",
      "types": "./src/runtime-projection.ts"
    },
    "./version": {
      "import": "./src/version.ts",
      "types": "./src/version.ts"
    }
  },
  "scripts": {
    "lint": "oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@okouai/api-contracts": "workspace:*",
    "@okouai/connectors": "workspace:*",
    "@okouai/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "eslint": "^9.34.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3"
  }
}
