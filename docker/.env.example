# ============ Required ============

# Domain for Caddy auto-HTTPS (use "localhost" for HTTP-only)
DOMAIN=localhost

# Database password (used by built-in PostgreSQL)
DB_PASSWORD=change_me_to_a_secure_password

# MinIO password (used by built-in MinIO)
MINIO_PASSWORD=change_me_to_a_secure_password

# ============ Optional ============

# Built-in PostgreSQL
# DB_USER=vm0
# DB_NAME=vm0
# DB_POOL_MAX=10

# External database (overrides built-in PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Built-in MinIO
# MINIO_USER=minioadmin
# MINIO_BUCKET=vm0-storages
# MINIO_CONSOLE_PORT=9001

# External S3-compatible storage (overrides built-in MinIO)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false
# R2_ACCESS_KEY_ID=your_key
# R2_SECRET_ACCESS_KEY=your_secret
# R2_USER_STORAGES_BUCKET_NAME=your_bucket

# Encryption key (64-char hex, auto-generated on first start if empty)
# Generate with: openssl rand -hex 32
# SECRETS_ENCRYPTION_KEY=

# Port mapping
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Concurrent run limit (0 = unlimited)
# CONCURRENT_RUN_LIMIT=0
