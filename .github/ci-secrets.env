# 1Password secret references for CI/CD
# Used by 1password/load-secrets-action via OP_ENV_FILE
# Format: ENV_VAR=op://vault/item/field
#
# Item naming convention follows turbo/apps/web/.env.local.tpl:
#   Each service gets its own item (clerk, vercel, neon, etc.)

# Vercel
VERCEL_TOKEN=op://Development/vercel/VERCEL_TOKEN
VERCEL_TEAM_ID=op://Development/vercel/VERCEL_TEAM_ID
VERCEL_PROJECT_ID_WEB=op://Development/vercel/VERCEL_PROJECT_ID_WEB
VERCEL_PROJECT_ID_DOCS=op://Development/vercel/VERCEL_PROJECT_ID_DOCS
VERCEL_PROJECT_ID_APP=op://Development/vercel/VERCEL_PROJECT_ID_APP
VERCEL_AUTOMATION_BYPASS_SECRET=op://Development/vercel/VERCEL_AUTOMATION_BYPASS_SECRET
PREVIEW_DOMAIN=op://Development/vercel/PREVIEW_DOMAIN

# Neon
NEON_API_KEY=op://Development/neon/NEON_API_KEY
NEON_PROJECT_ID=op://Development/neon/NEON_PROJECT_ID

# Clerk
CLERK_PUBLISHABLE_KEY=op://Development/clerk/CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=op://Development/clerk/CLERK_SECRET_KEY

# E2B
E2B_API_KEY=op://Development/e2b/E2B_API_KEY

# Cloudflare R2
R2_ACCOUNT_ID=op://Development/cloudflare/R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=op://Development/cloudflare/R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=op://Development/cloudflare/R2_SECRET_ACCESS_KEY
R2_USER_STORAGES_BUCKET_NAME=op://Development/cloudflare/R2_USER_STORAGES_BUCKET_NAME

# VM0
SECRETS_ENCRYPTION_KEY=op://Development/vm0/SECRETS_ENCRYPTION_KEY
OFFICIAL_RUNNER_SECRET=op://Development/vm0/OFFICIAL_RUNNER_SECRET
VM0_DEFAULT_AGENT=op://Development/vm0/VM0_DEFAULT_AGENT
CRON_SECRET=op://Development/vm0/CRON_SECRET

# Axiom
AXIOM_TOKEN_SESSIONS=op://Development/axiom/AXIOM_TOKEN_SESSIONS
AXIOM_TOKEN_TELEMETRY=op://Development/axiom/AXIOM_TOKEN_TELEMETRY

# Ably
ABLY_API_KEY=op://Development/ably/ABLY_API_KEY

# Anthropic (CI)
ANTHROPIC_API_KEY=op://Development/vm0/CI_ANTHROPIC_API_KEY

# Slack
